{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "strict": false,
    "sourceMap": false,
    "outDir": "dist",
    "types": ["node"],
    "paths": {
      "*": ["./node_modules/*", "./src/types/*"],
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    },
    "skipLibCheck": true,
    "removeComments": true
  },
  "exclude": ["node_modules/**/*", "dist/**/*"],
  "include": ["src/**/*", "test/**/*", "./vitest.config.mts"]
}
